# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase (Postgres)
# In Supabase: open your project, click "Connect" (top bar), and copy the two
# connection strings below. Replace [YOUR-PASSWORD] with your database password.
# If the password has special characters (@ : / ? # %), URL-encode them,
# e.g. @ -> %40, # -> %23  - or reset it to letters and numbers only.
# ---------------------------------------------------------------------------

# Used by the app. "Transaction pooler" connection (port 6543). Works on Vercel/serverless.
# Looks like: postgresql://postgres.abcdefghijkl:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Used for migrations and seeding. "Session pooler" connection (port 5432).
# Looks like: postgresql://postgres.abcdefghijkl:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ---------------------------------------------------------------------------
# Login cookies: a long random string. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=
